  @'
  # Dependencies
  node_modules/
  .pnp
  .pnp.js

  # Next.js build output
  frontend/.next/
  frontend/out/

  # Python
  __pycache__/
  *.py[cod]
  *.pyo
  .venv/
  venv/
  *.egg-info/

  # Env files — NEVER commit secrets
  .env
  .env.local
  .env.*.local

  # OS
  .DS_Store
  Thumbs.db

  # Editor
  .vscode/
  .idea/

  # Claude Code working files (session state, not part of the project)
  .claude/
'@ | Out-File -Encoding utf8 .gitignore
.claude/
